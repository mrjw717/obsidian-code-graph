# vscode
.vscode 

# Intellij
*.iml
.idea

# npm
node_modules

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js

# Exclude sourcemaps
*.map

# obsidian
data.json

# tree-sitter WASM assets (copied at build time from node_modules)
wasm

# Generated embedded-wasm module (base64 constants, regenerated each build)
src/indexer/wasm-embedded.ts

# Dev logs
.logs

# Exclude macOS Finder (System Explorer) View States
.DS_Store
